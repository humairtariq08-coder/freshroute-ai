# Copy to .env in the project root. VITE_ values are public browser configuration.
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths resolve from the project root.
DATABASE_PATH=backend/data/freshroute.db

# Backend only. Official Google-hosted Gemma 4; no Ollama required.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
