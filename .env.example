# Copy to .env in the project root. VITE_ values are public browser configuration.
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths resolve from the project root.
DATABASE_PATH=backend/data/freshroute.db
# Production PostgreSQL URL. Keep this backend-only and never commit its value.
DATABASE_URL=
# Optional dedicated disposable PostgreSQL database used only by concurrency tests.
TEST_DATABASE_URL=
# Production requires an explicit persistent path outside the OS temporary directory.
APP_ENV=development
SQLITE_BUSY_TIMEOUT_MS=10000

# Backend only. Official Google-hosted Gemma 4; no Ollama required.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
